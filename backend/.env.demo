# backend/.env.demo
# =================
# Ready-to-use demo environment for the Threshold hackathon demo.
# Copy to .env:  copy backend\.env.demo backend\.env   (Windows)
#                cp  backend/.env.demo  backend/.env   (Mac/Linux)
#
# THRESHOLD_ENV=demo  uses in-memory fixtures for Ring, store, and push.
# Only Bedrock is real (Nova Micro).  No DynamoDB, no KMS, no Ring credentials.
#
# ── AWS CREDENTIALS ─────────────────────────────────────────────────────────
# Decode your bedrockkeys file to get the values:
#
#   node -e "
#     const raw = require('fs').readFileSync('bedrockkeys','utf8').trim();
#     const dec = Buffer.from(raw,'base64').toString('utf-8');
#     dec.split('\n').filter(Boolean).forEach(l => console.log(l));
#   "
#
# Then paste the values below.
AWS_ACCESS_KEY_ID=REPLACE_WITH_KEY_ID_FROM_BEDROCKKEYS
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_FROM_BEDROCKKEYS
AWS_REGION=us-east-1

# Bedrock model — confirmed available on this account (no EULA gate)
# Model ID used by real-bedrock.ts; set here for visibility only.
BEDROCK_REGION=us-east-1

# ── DEPLOYMENT ENV ───────────────────────────────────────────────────────────
# "demo" boots with in-memory fixtures for all AWS/Ring ports except Bedrock.
# Switch to "staging" only after real DynamoDB/KMS adapters are wired (Phase 3).
THRESHOLD_ENV=demo

# ── HTTP ─────────────────────────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0

# ── SECRETS (demo values — fixtures don't validate these) ───────────────────
# assertStrongSecret in config.ts only runs for DEPLOYABLE envs (staging/prod).
# In "demo" mode these local defaults are accepted.
SESSION_SECRET=local-dev-session-secret-change-me
WEBHOOK_HMAC_KEY=local-fixture-hmac-key
WEBHOOK_HMAC_KEYS=

# ── RING OAUTH (fixture values — ignored by FixtureRing) ────────────────────
RING_CLIENT_ID=local-fixture-client
RING_CLIENT_SECRET=local-fixture-secret
RING_AUTHORIZE_URL=https://oauth.ring.com/oauth/authorize
RING_TOKEN_URL=https://oauth.ring.com/oauth/token
RING_REDIRECT_URI=http://localhost:8080/oauth/callback
RING_API_BASE=https://api.ring.com

# ── APP DEEP LINK ─────────────────────────────────────────────────────────────
APP_DEEP_LINK=threshold://auth/complete

# ── WEBSOCKET ORIGINS ─────────────────────────────────────────────────────────
# Allow the phone_doorbell.html page and Flutter web to connect.
# Add your machine's local IP if serving from a phone on WiFi, e.g.:
#   WS_ALLOWED_ORIGINS=http://localhost:3000,http://192.168.1.42:3000
# Empty = only native clients (no Origin header) are allowed — Flutter app is fine.
WS_ALLOWED_ORIGINS=

# ── LIMITS (matches config.ts defaults) ─────────────────────────────────────
BODY_LIMIT_BYTES=65536
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
WS_MAX_PAYLOAD_BYTES=65536
ASR_MAX_SESSIONS_PER_RESIDENT=2
ASR_MAX_SESSION_MS=600000
ASR_OPEN_TIMEOUT_MS=5000
ASR_MAX_PENDING_FRAMES=256

# ── KMS (ignored in demo mode — LocalCrypto is used instead) ─────────────────
KMS_KEY_ID=alias/threshold-ring-tokens

# ── HOW TO RUN ────────────────────────────────────────────────────────────────
# 1. Fill in AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY above.
# 2. Install the Bedrock SDK:
#      cd backend && npm install @aws-sdk/client-bedrock-runtime
# 3. Wire RealBedrock in container.ts (see real-bedrock.ts header for instructions).
# 4. Start:
#      cd backend && npm run dev
# 5. Open app/spike/phone_doorbell.html on a second phone/browser.
# 6. flutter run on your Android device.
# 7. Tap "Ring Doorbell" on the phone — captions appear on the Flutter app.
