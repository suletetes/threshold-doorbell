# Threshold backend environment (example). Copy to .env for local dev.
# In "local" mode the service uses fixtures only: no AWS, no real Ring.

# Deployment environment: local | staging | demo
THRESHOLD_ENV=local

# HTTP
PORT=8080
HOST=0.0.0.0

# Session signing (app-to-backend session credential). 32+ random bytes, base64.
SESSION_SECRET=local-dev-session-secret-change-me

# Ring OAuth (application secret; NEVER shipped to the app).
RING_CLIENT_ID=local-fixture-client
RING_CLIENT_SECRET=local-fixture-secret
RING_AUTHORIZE_URL=https://oauth.ring.com/oauth/authorize
RING_TOKEN_URL=https://oauth.ring.com/oauth/token
RING_REDIRECT_URI=http://localhost:8080/oauth/callback
RING_API_BASE=https://api.ring.com

# App deep link used after OAuth callback.
APP_DEEP_LINK=threshold://auth/complete

# Webhook HMAC key (application secret).
WEBHOOK_HMAC_KEY=local-fixture-hmac-key

# KMS key id (staging/demo only; local uses a fixture envelope).
KMS_KEY_ID=alias/threshold-ring-tokens
