# Threshold backend environment (example). Copy to .env for local dev.
# In "local" mode the service uses fixtures only: no AWS, no real Ring.
#
# Every variable config.ts reads is documented below with its default. The
# values shown are the LOCAL FIXTURE defaults: they are safe for local/test only.
# A deployable env (staging or demo that is deployed) FAILS FAST at boot
# (assertStrongSecret in config.ts) if SESSION_SECRET, WEBHOOK_HMAC_KEY, or
# RING_CLIENT_SECRET is left at its insecure default or is shorter than 32
# characters, so a deployed instance can never run with these placeholders.

# Deployment environment: local | staging | demo | test
# - local: developer loopback, fixtures, exempt from the strong-secret guard.
# - test:  the in-process vitest harness; never shipped to a host, also exempt.
# - staging | demo: deployable; the strong-secret guard runs (see note above).
THRESHOLD_ENV=local

# HTTP
PORT=8080
HOST=0.0.0.0

# Session signing (app-to-backend session credential). 32+ random bytes, base64.
# MUST be a strong 32+ character secret outside local/test, or boot fails.
SESSION_SECRET=local-dev-session-secret-change-me

# Ring OAuth (application secret; NEVER shipped to the app).
# RING_CLIENT_SECRET MUST be a strong 32+ character secret outside local/test.
RING_CLIENT_ID=local-fixture-client
RING_CLIENT_SECRET=local-fixture-secret
RING_AUTHORIZE_URL=https://oauth.ring.com/oauth/authorize
RING_TOKEN_URL=https://oauth.ring.com/oauth/token
RING_REDIRECT_URI=http://localhost:8080/oauth/callback
RING_API_BASE=https://api.ring.com

# App deep link used after OAuth callback.
APP_DEEP_LINK=threshold://auth/complete

# Webhook HMAC key (application secret). The primary key used to sign in tests
# and tooling. MUST be a strong 32+ character secret outside local/test.
WEBHOOK_HMAC_KEY=local-fixture-hmac-key

# Additional accepted webhook HMAC keys for rotation: a comma-separated list,
# NEWEST FIRST. During a key rotation, add the new key here (or promote it to
# WEBHOOK_HMAC_KEY) so deliveries signed with either key are accepted for the
# overlap window. Empty by default (only WEBHOOK_HMAC_KEY is accepted).
WEBHOOK_HMAC_KEYS=

# Browser Origins allowed to open a WebSocket, comma-separated (e.g.
# https://app.example.com). EMPTY BY DEFAULT, which means NO browser WebSocket
# client can connect: only native clients (which send no Origin header) are
# allowed until this is set. This empty default is the common misdiagnosis when
# a browser WS connection is rejected; set the allowed Origins here to fix it.
WS_ALLOWED_ORIGINS=

# Request/limit knobs (all positive integers; a non-numeric value fails boot).
# Max JSON request body in bytes (default 65536 = 64 KiB).
BODY_LIMIT_BYTES=65536
# HTTP rate limit: max requests per window, and the window length in ms.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
# Max WebSocket frame payload in bytes (default 65536 = 64 KiB).
WS_MAX_PAYLOAD_BYTES=65536

# ASR (Clarity Mode streaming) guards.
# Max concurrent /asr/stream sessions per resident.
ASR_MAX_SESSIONS_PER_RESIDENT=2
# Hard cap on a single /asr/stream session duration in ms (default 600000 = 10m).
ASR_MAX_SESSION_MS=600000
# How long to wait for the upstream Transcribe stream to open, in ms.
ASR_OPEN_TIMEOUT_MS=5000
# Max audio frames buffered while the stream is opening.
ASR_MAX_PENDING_FRAMES=256

# KMS key id (staging/demo only; local uses a fixture envelope).
KMS_KEY_ID=alias/threshold-ring-tokens
