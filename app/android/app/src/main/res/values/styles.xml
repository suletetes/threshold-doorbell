<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      LaunchTheme: applied while the Android process is starting (light mode).
      Background is the brand dark-navy so the native splash and the Flutter
      SplashScreen widget share the same colour and the transition is invisible.
      NoTitleBar avoids any system chrome appearing over the splash.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Keep the status bar icon tint light (white icons on dark background). -->
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!--
      NormalTheme: applied as soon as the Flutter engine has drawn its first
      frame. The window background returns to the system default so Flutter's
      own surface colour shows through correctly.
    -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
