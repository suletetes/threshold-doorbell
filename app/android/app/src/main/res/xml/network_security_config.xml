<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security config (LOW-14).

  Production traffic is cleartext-forbidden by the base config: all backend calls
  must use HTTPS. Cleartext is permitted only in debug builds, and only for:
    - local dev hosts (emulator loopback, localhost)
    - the live AWS ALB endpoint (*.elb.amazonaws.com) — HTTP only, no HTTPS cert
      on the bare ELB hostname. For production, attach an ACM cert via a custom
      domain and remove this entry.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <debug-overrides>
        <domain-config cleartextTrafficPermitted="true">
            <!-- Local development -->
            <domain includeSubdomains="true">10.0.2.2</domain>
            <domain includeSubdomains="true">localhost</domain>
            <domain includeSubdomains="true">127.0.0.1</domain>
            <!-- LAN backend (two-phone WiFi demo) -->
            <domain includeSubdomains="true">192.168.0.0</domain>
            <domain includeSubdomains="true">192.168.1.0</domain>
            <domain includeSubdomains="true">192.168.2.0</domain>
            <!-- Live AWS ALB (HTTP — no HTTPS cert on bare ELB hostname) -->
            <domain includeSubdomains="true">elb.amazonaws.com</domain>
        </domain-config>
    </debug-overrides>
</network-security-config>
